# Salin file ini menjadi .env lalu isi API key kamu.
# Cara dapat key: daftar di https://www.themoviedb.org/signup
# lalu buka https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Database Turso (untuk fitur Daftar Saya & riwayat tontonan).
# Buat database di https://turso.tech, lalu salin URL & token-nya.
# Contoh:
# TURSO_DATABASE_URL=libsql://nama-db-nama-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# (Opsional) Origin lintas-domain yang diizinkan mengakses API (CORS),
# dipisah koma. Kosongkan = hanya same-origin yang diizinkan (default).
# ALLOWED_ORIGINS=https://contoh-depan.com,https://admin.contoh.com
ALLOWED_ORIGINS=

# (Opsional) Pengaturan rate limit (anti-DoS), dalam milidetik & jumlah request.
# Default: jendela 60 detik, 120 request umum, 30 aksi tulis (POST/DELETE).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WRITE_MAX=30

# (Opsional) Set 1 bila server berjalan di belakang reverse proxy (agar IP
# pengguna terdeteksi benar). TRUST_PROXY=

# --- Login GitHub (OAuth) ---
# Cara buat OAuth App:
# 1. Buka https://github.com/settings/developers -> OAuth Apps -> New OAuth App.
# 2. Homepage URL: http://localhost:5173 (dev) atau https://domain-anda.vercel.app.
# 3. Authorization callback URL:
#    - Lokal (Vite proxy ke Express):  http://localhost:5173/api/auth/callback
#    - Produksi (Vercel):              https://domain-anda.vercel.app/api/auth/callback
# 4. Generate client secret, lalu salin Client ID & Secret ke bawah.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL dasar frontend (tanpa trailing slash). Dipakai untuk menyusun
# redirect_uri OAuth dan tujuan redirect setelah login berhasil.
APP_URL=http://localhost:5173
