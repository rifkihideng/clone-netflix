# Salin file ini menjadi .env lalu isi API key kamu.
# Cara dapat key: daftar di https://www.themoviedb.org/signup
# lalu buka https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Database Turso (untuk fitur Daftar Saya & riwayat tontonan).
# Buat database di https://turso.tech, lalu salin URL & token-nya.
# Contoh:
# TURSO_DATABASE_URL=libsql://nama-db-nama-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
